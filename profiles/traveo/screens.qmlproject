import QmlProject 1.3

Project {
    projectRootPath: "../.."

    MCU.Module {
        uri: "ClusterScreens"
    }

    ModuleFiles {
        files: [
            "qml/backend/backend.qmlproject",
            "profiles/traveo/core.qmlproject",
            "profiles/traveo/components.qmlproject"
